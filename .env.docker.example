# Used by docker-compose.yml (env_file: .env.docker):  cp .env.docker.example .env.docker
# Service hostnames below are the compose service names.
MONGODB_URI=mongodb://mongodb:27017/rankengine
REDIS_URL=redis://redis:6379
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=rankengine123

# Leave keys blank for degraded modes (chat falls back to [Simulated],
# embeddings fall back to hash vectors).
GROQ_API_KEY=
GEMINI_API_KEY=
SERP_API_KEY=
SE_RANKING_API_KEY=
PAGESPEED_API_KEY=

LOG_LEVEL=INFO
LOG_DIR=logs
