# Copy to .env for local development:  cp .env.example .env
# Every setting is optional; missing keys put the related feature into a degraded mode.

# --- Infrastructure -------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/rankengine
REDIS_URL=redis://localhost:6379

# --- LLM / data providers -------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
SERP_API_KEY=
SE_RANKING_API_KEY=
PAGESPEED_API_KEY=

# --- Google Search Console ------------------------------------------------
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=http://localhost:8001/api/gsc/callback
# Either a stored OAuth refresh token ...
GSC_REFRESH_TOKEN=
# ... or a service-account key file (needs the google-auth package, see requirements.txt)
GSC_SERVICE_ACCOUNT_FILE=

# --- Integrations ----------------------------------------------------------
GITHUB_TOKEN=
SLACK_WEBHOOK_URL=
ACTION_WEBHOOK_URL=

# Email reports (the in-app Settings > Email tab overrides these)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Agent limits ----------------------------------------------------------
AGENT_MAX_STEPS=15
AGENT_DEFAULT_BUDGET=100.0
AGENT_CHECKPOINT_THRESHOLD=50.0

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
